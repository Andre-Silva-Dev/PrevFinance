# ==============================
# Infrastructure (Docker)
# ==============================
POSTGRES_DB=prevfinance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379

# ==============================
# Backend (ASP.NET Core)
# ==============================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5071
BACKEND_URL=http://localhost:5071

# Connection string consumed by ASP.NET Core configuration as:
# ConnectionStrings__DefaultConnection
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=prevfinance_dev;Username=postgres;Password=postgres

# JWT (use secrets manager in non-local environments)
Jwt__Issuer=PrevFinance.Dev
Jwt__Audience=PrevFinance.Client
Jwt__SigningKey=PrevFinance-Dev-Secret-Key-For-Local-Only-2026
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7

# Optional technical seed
Seed__EnableTechnicalSeed=true

# ==============================
# Frontend (Angular)
# ==============================
# Dev server URL
FRONTEND_URL=http://localhost:4200

# API URL reference for frontend integrations and proxy target docs.
# Frontend runtime currently calls /api and relies on src/frontend/proxy.conf.cjs in dev.
FRONTEND_API_BASE_URL=http://localhost:5071/api
